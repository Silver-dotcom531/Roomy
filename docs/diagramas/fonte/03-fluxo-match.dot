// Diagrama 3 - Fluxo do match por interesse mutuo (conceitual)
// Fonte: RF-008, RF-009, RNE-006, RNE-007
digraph fluxo_match {
  graph [fontname="DejaVu Sans", rankdir=TB, nodesep=0.4, ranksep=0.27, pad=0.15,
         splines=true, bgcolor="white", dpi=250];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled",
         margin="0.12,0.06", penwidth=1.3, color="#44546A", fontcolor="#0F1C2E"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#0F1C2E", penwidth=1.2,
         arrowsize=0.8, fontcolor="#0F1C2E"];

  start [shape=circle, label="", width=0.22, style=filled, fillcolor="#0F1C2E", color="#0F1C2E"];
  fim   [shape=doublecircle, label="", width=0.22, style=filled, fillcolor="#0F1C2E", color="#0F1C2E"];

  s1  [label="Locatário preenche o perfil de convivência\n(voluntário; pode ser editado ou removido\na qualquer momento) — RF-008",
       fillcolor="#D4F1EC", color="#138A7A"];
  s2  [label="Sistema sugere perfis compatíveis, com base\napenas em informações declaradas\n(RF-009 e RNE-006)",
       fillcolor="#E3E8EF"];
  s3  [label="Locatário A analisa o perfil\nsugerido de Locatário B",
       fillcolor="#D4F1EC", color="#138A7A"];
  s4  [label="A demonstra\ninteresse em B?", shape=diamond, style="filled",
       margin="0.16,0.06", fillcolor="#D4F1EC", color="#138A7A"];
  s4n [label="A desconsidera B;\nB não é notificado (RF-009)",
       fillcolor="#E3E8EF"];
  s5  [label="Sistema registra o interesse de A em B",
       fillcolor="#E3E8EF"];
  s6  [label="B também demonstrou\ninteresse em A?", shape=diamond, style="filled",
       margin="0.16,0.06", fillcolor="#E3E8EF"];
  s6n [label="Contato permanece bloqueado\naté haver interesse mútuo (RF-009)",
       fillcolor="#E3E8EF"];
  s7  [label="Sistema libera o contato entre A e B (RNE-006);\ndados pessoais diretos só por ação\nvoluntária do usuário (RNE-007)",
       fillcolor="#E3E8EF"];

  start -> s1;
  s1 -> s2 -> s3 -> s4;
  s4 -> s4n [label=" Não "];
  s4 -> s5  [label=" Sim "];
  s5 -> s6;
  s6 -> s6n [label=" Não "];
  s6n -> s6 [style=dashed, constraint=false, label=" se B demonstrar\n interesse depois "];
  s6 -> s7  [label=" Sim "];
  s7 -> fim;

  {rank=same; start; s1;}
  {rank=same; s4; s4n;}
  {rank=same; s6; s6n;}
  {rank=same; s7; fim;}

  subgraph cluster_leg {
    label="Legenda"; labeljust=l; fontname="DejaVu Sans"; fontsize=10; style="rounded"; color="#44546A";
    l1 [label="Locatário", fillcolor="#D4F1EC", color="#138A7A", fontsize=9];
    l2 [label="Sistema", fillcolor="#E3E8EF", fontsize=9];
    {rank=same; l1; l2;}
    l1 -> l2 [style=invis];
  }
  s7 -> l1 [style=invis];
}
